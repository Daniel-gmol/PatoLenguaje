init fibo_rec;

entero fib(x : entero){
    val a, b, tmp: entero;
    {
        a = 0;
        b = 1;
        esperaque (x > 0) \/ {
           tmp = a + b; 
           a = b;
           b = tmp;
           x = x - 1;
        }
        regresa a;
    }
}

arranca{
    dale("fib(0) = ", fib(0), "\n");
    dale("fib(1) = ", fib(1), "\n");
    dale("fib(2) = ", fib(2), "\n");
    dale("fib(3) = ", fib(3), "\n");
    dale("fib(4) = ", fib(4), "\n");
    dale("fib(10) = ", fib(10), "\n");
}
acaba