init complete;
val
    x, y, res : entero;
    pi, phi : decimal;

nil imprimeRes(r: entero, l: decimal) {
    {
        r = 12 * r;
        phi = 1.618 - l;
        dale("Resultado: ", r);

        regresa nil;
    }
}

entero suma(a: entero, b: entero) {
    val 
        s : entero;
        v : decimal;
    {
        si (a > 1){
            s = suma(a - 1, b);
            v = 1.0;
        }
        regresa (s + b) / 3;
    }
}

arranca {
    x = 10;
    y = 20;
    pi = 3.14;
    res = x + y * 2;

    si (res > 30) {
        dale("Grande");
    } sino {
        dale("Pequeño");
    }

    esperaque (x > 0) \/ {
        x = x - 1;
    }

    imprimeRes(res, phi);
    x = suma(x, y);

    x = 5;
}
acaba
