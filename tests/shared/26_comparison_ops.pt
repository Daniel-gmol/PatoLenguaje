init comparisons;
val
    a, b : entero;
arranca {
    a = 10;
    b = 20;

    # Less than
    si (a < b) {
        dale("a < b: true\n");
    } sino {
        dale("a < b: false\n");
    }

    # Greater than
    si (a > b) {
        dale("a > b: true\n");
    } sino {
        dale("a > b: false\n");
    }

    # Equal
    si (a == b) {
        dale("a == b: true\n");
    } sino {
        dale("a == b: false\n");
    }

    # Not equal
    si (a != b) {
        dale("a != b: true\n");
    } sino {
        dale("a != b: false\n");
    }

    # Edge: compare same value
    si (a == a) {
        dale("a == a: true\n");
    }

    si (a != a) {
        dale("a != a: true\n");
    } sino {
        dale("a != a: false\n");
    }
}
acaba
