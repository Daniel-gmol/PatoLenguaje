init nested_if;
val
    x : entero;
arranca {
    x = 42;
    si (x > 10) {
        si (x > 20) {
            si (x > 30) {
                si (x > 40) {
                    dale("x > 40\n");
                } sino {
                    dale("30 < x <= 40\n");
                }
            } sino {
                dale("20 < x <= 30\n");
            }
        } sino {
            dale("10 < x <= 20\n");
        }
    } sino {
        dale("x <= 10\n");
    }
}
acaba
