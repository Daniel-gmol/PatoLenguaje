init recursion;
val result : entero;

# Self-recursion: a function calling itself (works fine)
entero factorial(n: entero) {
    {
        si (n < 2) {
            regresa 1;
        }
        regresa n * factorial(n - 1);
    }
}

# Chained calls (A calls B, but no circularity)
entero addTwo(x: entero) {
    {
        regresa x + 2;
    }
}

entero transform(x: entero) {
    {
        regresa addTwo(x) * 3;
    }
}

arranca {
    result = factorial(5);
    dale("5! = ", result, "\n");

    result = factorial(0);
    dale("0! = ", result, "\n");

    result = transform(4);
    dale("transform(4) = ", result, "\n");
}
acaba
