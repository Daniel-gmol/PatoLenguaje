init nested_calls;
val result : entero;

entero addOne(x: entero) {
    {
        regresa x + 1;
    }
}

entero double(x: entero) {
    {
        regresa x * 2;
    }
}

entero triple(x: entero) {
    {
        regresa x * 3;
    }
}

arranca {
    # f(g(h(x))) pattern
    result = addOne(double(triple(2)));
    dale("addOne(double(triple(2))) = ", result, "\n");

    result = triple(addOne(double(5)));
    dale("triple(addOne(double(5))) = ", result, "\n");
}
acaba
