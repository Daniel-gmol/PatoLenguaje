init prog;
    val i, j : entero;

entero uno(x: entero){
    {
        regresa x;
    }
};

entero dos(x: entero){
    {
        regresa x;
    }
};

entero suma(a: entero, b: entero){
    {
        regresa a + b;
    }
};

arranca {
    i = 10;

    j = suma(uno(1), dos(4));
    dale("j: ", j);

    dale("\n");

    i = suma(uno(i), i);
    dale("i: ", i);
}
